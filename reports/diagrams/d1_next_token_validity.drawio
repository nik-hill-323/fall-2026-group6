<mxfile host="app.diagrams.net">
<diagram id="ntv-full" name="Next-Token Validity Full Flow">
<mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1654" pageHeight="2339">
<root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Diagnostic 1 — Next-Token Validity (Othello)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="520" height="55" as="geometry"/></mxCell><mxCell id="a" value="Held-out Othello game sequence" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="320" height="55" as="geometry"/></mxCell><mxCell id="b" value="Choose a sequence prefix
Example: D3 → C3 → C4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="185" width="320" height="65" as="geometry"/></mxCell><mxCell id="c1" value="Ground-truth branch" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="90" y="285" width="260" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Replay prefix with deterministic Othello rules engine" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="300" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Reconstruct true board state + determine current player" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="465" width="300" height="70" as="geometry"/></mxCell><mxCell id="c4" value="Generate ALL legal next moves
Example: {C5, E3}" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="300" height="70" as="geometry"/></mxCell><mxCell id="m1" value="Model branch" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="285" width="260" height="50" as="geometry"/></mxCell><mxCell id="m2" value="Choose trained sequence model
Transformer / LSTM / SSM" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="365" width="300" height="70" as="geometry"/></mxCell><mxCell id="m3" value="Feed SAME prefix to model
D3 → C3 → C4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="465" width="300" height="70" as="geometry"/></mxCell><mxCell id="m4" value="Model outputs next-token probabilities" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="565" width="300" height="70" as="geometry"/></mxCell><mxCell id="m5" value="Take top-1 / argmax proposal
Example: C5" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="665" width="300" height="70" as="geometry"/></mxCell><mxCell id="d" value="Is proposed move in legal-move set?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="720" width="320" height="90" as="geometry"/></mxCell><mxCell id="yes" value="VALID = 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="245" y="850" width="220" height="55" as="geometry"/></mxCell><mxCell id="no" value="INVALID = 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="615" y="850" width="220" height="55" as="geometry"/></mxCell><mxCell id="save" value="Save prefix, prediction, legal set, validity" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="945" width="320" height="65" as="geometry"/></mxCell><mxCell id="repeat" value="Repeat over all eligible prefixes and held-out games" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="1040" width="320" height="65" as="geometry"/></mxCell><mxCell id="score" value="Next-Token Validity = valid predictions ÷ total predictions" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="1140" width="380" height="75" as="geometry"/></mxCell><mxCell id="n1" value="Important: the model does NOT receive the board or legal-move set. Only the move prefix is given to the model." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1030" y="420" width="300" height="110" as="geometry"/></mxCell><mxCell id="n2" value="Interpreter and navigation are domains, not model architectures. The model families are Transformer, LSTM, and SSM." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1030" y="570" width="300" height="110" as="geometry"/></mxCell><mxCell id="n3" value="Toy demo may use a tiny predictor because the goal is to show how the diagnostic is computed." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1030" y="720" width="300" height="110" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="m5" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d" target="yes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="d" target="no"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="yes" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="no" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="save" target="repeat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="repeat" target="score"><mxGeometry relative="1" as="geometry"/></mxCell>
