<mxfile host="app.diagrams.net"><diagram id="zoo-pipeline" name="Zoo training pipeline"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="How the Othello model zoo is trained and tested" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="14" width="1180" height="30" as="geometry"/></mxCell><mxCell id="lane0" value="1. Data  (src/domains/othello.py)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#dae8fc;opacity=60;strokeColor=#888888;verticalAlign=top;align=right;spacingRight=12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1140" height="200" as="geometry"/></mxCell><mxCell id="lane1" value="2. Training  (src/zoo/train.py, run by src/shellscripts/train_slice.sh on 4 EC2s)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#d5e8d4;opacity=60;strokeColor=#888888;verticalAlign=top;align=right;spacingRight=12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="1140" height="250" as="geometry"/></mxCell><mxCell id="lane2" value="3. Admission, storage and testing" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e1d5e7;opacity=60;strokeColor=#888888;verticalAlign=top;align=right;spacingRight=12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="570" width="1140" height="300" as="geometry"/></mxCell><mxCell id="syn" value="&lt;b&gt;Synthetic games&lt;/b&gt;&lt;br&gt;othello_world: random legal moves,&lt;br&gt;about 19 million games" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="66" as="geometry"/></mxCell><mxCell id="cha" value="&lt;b&gt;Championship games&lt;/b&gt;&lt;br&gt;WTHOR archive: 137,548 human&lt;br&gt;games, 1977 to 2025" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="176" width="250" height="66" as="geometry"/></mxCell><mxCell id="mix" value="&lt;b&gt;Three training sets&lt;/b&gt;&lt;br&gt;synthetic, championship,&lt;br&gt;mixed (both pools together)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="220" height="82" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Rules engine replays every game&lt;/b&gt;&lt;br&gt;true board and legal moves&lt;br&gt;after every move; illegal games&lt;br&gt;dropped (none found)&lt;br&gt;&lt;br&gt;split 80 / 10 / 10:&lt;br&gt;train / val / test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="100" width="270" height="142" as="geometry"/></mxCell><mxCell id="tok" value="&lt;b&gt;Tokens&lt;/b&gt;&lt;br&gt;one token per move: the square&lt;br&gt;played (60 squares, token 1 to 60)&lt;br&gt;a game = up to 59 tokens;&lt;br&gt;passes are not tokens&lt;br&gt;&lt;br&gt;the whole game fits: no window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="260" height="142" as="geometry"/></mxCell><mxCell id="arch" value="&lt;b&gt;One model per cell&lt;/b&gt;&lt;br&gt;&lt;br&gt;3 architectures:&lt;br&gt;transformer, LSTM, Mamba&lt;br&gt;3 scales: 4x128, 6x256, 8x512&lt;br&gt;3 training sets: synthetic,&lt;br&gt;championship, mixed&lt;br&gt;3 seeds: 0, 1, 2&lt;br&gt;= 81 models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="260" height="190" as="geometry"/></mxCell><mxCell id="obj" value="&lt;b&gt;Objective (teacher forcing)&lt;/b&gt;&lt;br&gt;&lt;br&gt;input: moves 1 to t of a real game&lt;br&gt;output: a score for each of the 60&lt;br&gt;squares for move t+1&lt;br&gt;&lt;br&gt;cross entropy at every position;&lt;br&gt;the model always reads the real&lt;br&gt;history, never its own guesses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="300" height="190" as="geometry"/></mxCell><mxCell id="bud" value="&lt;b&gt;Same budget for all&lt;/b&gt;&lt;br&gt;&lt;br&gt;5,000 steps&lt;br&gt;256 games per step&lt;br&gt;(1,280,000 games)&lt;br&gt;AdamW, lr 3e-4,&lt;br&gt;200 warmup steps,&lt;br&gt;cosine decay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="220" height="190" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;model.pt (checkpoint)&lt;br&gt;&lt;br&gt;training record:&lt;br&gt;final loss, val legal&lt;br&gt;move rate, sha256&lt;br&gt;of the checkpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="200" height="190" as="geometry"/></mxCell><mxCell id="adm" value="&lt;b&gt;Registry and admission&lt;/b&gt;&lt;br&gt;competence = legal move rate&lt;br&gt;on 1,000 val games;&lt;br&gt;admitted if at least 0.50&lt;br&gt;(81 of 81 admitted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="260" height="110" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;Shared storage&lt;/b&gt;&lt;br&gt;S3: shared/group6/zoo/&lt;br&gt;one folder per model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="610" width="220" height="110" as="geometry"/></mxCell><mxCell id="score" value="&lt;b&gt;score_slice.sh&lt;/b&gt;&lt;br&gt;checks sha256, then runs D1, D2,&lt;br&gt;D3, D4 and fragility v1, v2&lt;br&gt;on 1,000 test games of the&lt;br&gt;model&amp;#x27;s own training set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="610" width="270" height="110" as="geometry"/></mxCell><mxCell id="res" value="&lt;b&gt;Results&lt;/b&gt;&lt;br&gt;one JSON per model and test&lt;br&gt;(486 files, all status ok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="610" width="230" height="110" as="geometry"/></mxCell><mxCell id="ana" value="&lt;b&gt;Analysis (src/analysis/hypotheses.py, after tag prereg-v1.4)&lt;/b&gt;&lt;br&gt;master table, then H1, H2, H3 with the configuration bootstrap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="760" width="540" height="90" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Data roles never mix: train = training only;&lt;/b&gt;&lt;br&gt;val = admission and fitting the diagnostics;&lt;br&gt;test = every final score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="520" height="90" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="syn" target="mix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="cha" target="mix"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="mix" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="rules" target="tok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="arch" target="obj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="obj" target="bud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="bud" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="adm" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="s3" target="score"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="score" target="res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=block;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tok" target="arch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="285"/><mxPoint x="170" y="285"/></Array></mxGeometry></mxCell><mxCell id="e12" style="endArrow=block;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="rec" target="adm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="565"/><mxPoint x="170" y="565"/></Array></mxGeometry></mxCell><mxCell id="e13" style="endArrow=block;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="res" target="ana"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="740"/><mxPoint x="870" y="740"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
