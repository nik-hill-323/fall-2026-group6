<mxfile host="app.diagrams.net">
<diagram id="d2-full" name="State Equivalence Full Flow">
<mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1080" pageHeight="1100">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="t" value="Diagnostic 2: State Equivalence (Othello)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=18;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="520" height="55" as="geometry"/></mxCell>
<mxCell id="a" value="Test games of the model's own training distribution&lt;br&gt;1,000 games, data seed 0" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="b" value="Every prefix is one history h&lt;br&gt;Example: D3 → C3 → C4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="400" height="60" as="geometry"/></mxCell>
<mxCell id="c1" value="Ground truth branch" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="280" height="45" as="geometry"/></mxCell>
<mxCell id="c2" value="Replay h with the Othello rules engine&lt;br&gt;true board + player to move" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="365" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="c3" value="Truly legal next moves L(h)&lt;br&gt;Example: {C5, E3}" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="m1" value="Model branch" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="280" height="45" as="geometry"/></mxCell>
<mxCell id="m2" value="Feed the SAME history to the model&lt;br&gt;Transformer, LSTM or Mamba" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="365" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="m3" value="Accepted moves A(h) = model's top k squares&lt;br&gt;k = number of truly legal moves" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="460" width="320" height="65" as="geometry"/></mxCell>
<mxCell id="j" value="L(h) and A(h) for every history" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="340" y="565" width="400" height="55" as="geometry"/></mxCell>
<mxCell id="p1" value="Same state pairs&lt;br&gt;same board, different move order&lt;br&gt;up to 2,000 (more games if fewer than 500)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="p2" value="Different state pairs&lt;br&gt;same length, different legal moves&lt;br&gt;up to 2,000" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="e1" value="Compression error&lt;br&gt;share of accepted moves accepted&lt;br&gt;after only one of the two histories&lt;br&gt;0 is best" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="440" height="95" as="geometry"/></mxCell>
<mxCell id="e2" value="Distinction error&lt;br&gt;share of boundary moves (legal after only one)&lt;br&gt;the model does not separate correctly&lt;br&gt;0 is best" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="780" width="440" height="95" as="geometry"/></mxCell>
<mxCell id="s" value="D2 score = 1 minus the mean of the two errors&lt;br&gt;higher = more world model like" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="915" width="500" height="65" as="geometry"/></mxCell>
